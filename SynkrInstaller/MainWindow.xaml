<Window x:Class="SynkrInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SynkrFox Installer" Height="450" Width="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI, Inter, System" WindowStartupLocation="CenterScreen">
    
    <Border Background="#1E1E1E" CornerRadius="10" BorderBrush="#333" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Background="#252526" MouseLeftButtonDown="Header_MouseDown" Height="40">
                <TextBlock Text="SynkrFox Setup - v1.0.0.0" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                <Button Content="&#x2715;" HorizontalAlignment="Right" Width="40" Background="Transparent" Foreground="#CCC" BorderThickness="0" Click="Close_Click"/>
            </Grid>

            <!-- Content Area -->
            <Grid Grid.Row="1" Margin="30">
                <!-- Welcome Screen -->
                <StackPanel x:Name="ScreenWelcome">
                    <TextBlock Text="Welcome to SynkrFox" Foreground="#007ACC" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
                    <TextBlock Text="This will install SynkrFox v1.0.0.0 on your computer." Foreground="White" FontSize="14" Margin="0,0,0,10"/>
                    <TextBlock Text="SynkrFox is a high-performance, bi-directional file synchronization tool designed for speed and reliability." Foreground="#AAA" TextWrapping="Wrap" Margin="0,0,0,30"/>
                    
                    <Border Background="#2D2D30" Padding="15" CornerRadius="5">
                        <StackPanel>
                            <CheckBox x:Name="ChkDesktopIcon" Content="Create Desktop Shortcut" Foreground="White" IsChecked="True" Margin="0,0,0,10"/>
                            <CheckBox x:Name="ChkStartMenuIcon" Content="Create Start Menu Shortcut" Foreground="White" IsChecked="True"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Progress Screen -->
                <StackPanel x:Name="ScreenProgress" Visibility="Collapsed">
                    <TextBlock Text="Installing SynkrFox..." Foreground="#007ACC" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                    <TextBlock x:Name="TxtProgressStatus" Text="Extracting files..." Foreground="White" Margin="0,0,0,10"/>
                    <ProgressBar x:Name="InstallProgressBar" Height="25" Background="#333" Foreground="#007ACC" BorderThickness="0" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="TxtPercent" Text="0%" Foreground="#888" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Finished Screen -->
                <StackPanel x:Name="ScreenFinished" Visibility="Collapsed">
                    <TextBlock Text="Installation Complete!" Foreground="#00FF00" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
                    <TextBlock Text="SynkrFox v1.0.0.0 has been successfully installed." Foreground="White" FontSize="14" Margin="0,0,0,10"/>
                    <TextBlock Text="You can now close this installer and start syncing in all its glory." Foreground="#AAA" Margin="0,0,0,30"/>
                    
                    <CheckBox x:Name="ChkLaunchNow" Content="Launch SynkrFox Now" Foreground="White" IsChecked="True"/>
                </StackPanel>
                
                <!-- Uninstall Screen -->
                <StackPanel x:Name="ScreenUninstall" Visibility="Collapsed">
                    <TextBlock Text="Uninstall SynkrFox" Foreground="#FF5555" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
                    <TextBlock Text="Are you sure you want to remove SynkrFox and all its settings?" Foreground="White" FontSize="14" Margin="0,0,0,30"/>
                    <TextBlock Text="This will remove the application from Program Files and delete shortcuts." Foreground="#AAA" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <!-- Footer Buttons -->
            <Grid Grid.Row="2" Background="#252526" Height="60">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,20,0">
                    <Button x:Name="BtnBack" Content="Back" Width="80" Height="30" Background="#3E3E42" Foreground="White" BorderThickness="0" Margin="0,0,10,0" Click="Back_Click" Visibility="Collapsed"/>
                    <Button x:Name="BtnNext" Content="Next" Width="100" Height="30" Background="#007ACC" Foreground="White" BorderThickness="0" Click="Next_Click"/>
                    <Button x:Name="BtnFinish" Content="Finish" Width="100" Height="30" Background="#007ACC" Foreground="White" BorderThickness="0" Click="Finish_Click" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
