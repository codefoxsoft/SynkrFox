<Window x:Class="SynkrFox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SynkrFox"
        mc:Ignorable="d"
        Title="SynkrFox" Height="600" Width="900"
        WindowStyle="None"
        AllowsTransparency="True"
        Closing="Window_Closing"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent"
        FontFamily="Segoe UI, Inter, System">

    <!-- Resources MUST come BEFORE usage in XAML -->
    <Window.Resources>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="#1E1E1E" CornerRadius="10" BorderBrush="#333" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>    <!-- Main Content -->
                <RowDefinition Height="Auto"/> <!-- Footer/Status -->
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Background="#252526" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="10,0">
                    <Image x:Name="ImgIcon" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,10,0">
                         <Image.Clip>
                            <EllipseGeometry Center="12,12" RadiusX="12" RadiusY="12"/>
                        </Image.Clip>
                    </Image>
                    <TextBlock Text="SynkrFox" Foreground="White" VerticalAlignment="Center" FontWeight="Bold" FontSize="16"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="&#x2014;" Width="40" Height="40" Background="Transparent" Foreground="#CCC" BorderThickness="0" Click="Minimize_Click" Style="{StaticResource TitleBarButtonStyle}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="&#x2715;" Width="40" Height="40" Background="Transparent" Foreground="#CCC" BorderThickness="0" Click="Close_Click" Style="{StaticResource TitleBarButtonStyle}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>

            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Panel: Configuration -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <StackPanel.Resources>
                        <local:PathTrimmingConverter x:Key="PathTrimmer"/>
                    </StackPanel.Resources>

                    <!-- Statistics Panel -->
                    <Border Background="#252526" CornerRadius="5" Padding="10" Margin="0,0,0,15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Sync Status" Foreground="#AAA" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <StackPanel Grid.Row="1" Margin="0,0,0,3">
                                <TextBlock x:Name="TxtSyncStatus" Text="Stopped" Foreground="#00FF00" FontSize="12" Margin="0,0,0,2"/>
                                <ProgressBar x:Name="SyncProgressBar" Height="4" Background="#333" Foreground="#00FF00" BorderThickness="0" IsIndeterminate="False" Visibility="Collapsed"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtStats" Grid.Row="2" Text="0 files (0 MB) | Conflicts: 0 | Errors: 0" Foreground="#888" FontSize="10"/>
                        </Grid>
                    </Border>
                    
                    <TextBlock Text="Backup Destination" Foreground="#AAA" Margin="0,0,0,5" FontWeight="SemiBold"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtBackupPath" Background="#333" Foreground="White" BorderThickness="0" Padding="5" IsReadOnly="True" Grid.Column="0"/>
                        <Button Content="..." Width="30" Background="#444" Foreground="White" BorderThickness="0" Grid.Column="1" Click="BrowseBackup_Click"/>
                    </Grid>

                    <TextBlock Text="Source Folders" Foreground="#AAA" Margin="0,0,0,5" FontWeight="SemiBold"/>
                    <ListBox x:Name="ListSourceFolders" Background="#333" BorderThickness="0" Foreground="White" Height="150" Margin="0,0,0,10" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Converter={StaticResource PathTrimmer}}" VerticalAlignment="Center" ToolTip="{Binding}"/>
                                    <Button Content="X" Width="20" Height="20" Background="Transparent" Foreground="#FF5555" BorderThickness="0" 
                                            Grid.Column="1" Click="RemoveFolder_Click" Tag="{Binding}" Margin="5,0,0,0" FontWeight="Bold"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="+ Add Folder" Width="100" Height="30" Background="#3E3E42" Foreground="White" BorderThickness="0" Click="AddFolder_Click"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="⟳ Force Sync" Width="95" Height="30" Background="#007ACC" Foreground="White" BorderThickness="0" Margin="0,0,5,0" Click="ForceSync_Click" ToolTip="Rescan all files now"/>
                            <Button x:Name="BtnToggleSync" Content="Disable Live Sync" Width="110" Height="30" Background="#FF5555" Foreground="White" BorderThickness="0" Click="ToggleSync_Click"/>
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="ChkStartWithPC" Content="Start with PC" Foreground="#AAA" Margin="0,10,0,0" VerticalAlignment="Center" Click="ChkStartWithPC_Click" IsChecked="True"/>
                </StackPanel>

                <!-- Right Panel: Logs/Status -->
                <Border Grid.Column="1" Background="#111" CornerRadius="5" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Activity Log" Foreground="#AAA" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="TxtLastSync" Text="Last sync: Never" Foreground="#666" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBox x:Name="TxtLog" Grid.Row="1" Margin="0,10,0,0" Background="Transparent" Foreground="#00FF00" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="2" Background="#007ACC" Height="25">
                 <TextBlock x:Name="TxtCredits" Text="v1.0.0.0 by codefoxsoft" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="10"/>
            </Grid>
        </Grid>
    </Border>

</Window>
